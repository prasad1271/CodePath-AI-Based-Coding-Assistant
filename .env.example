# ============================================================
# CODEPATH - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env for local testing or set these variables
# on Vercel (Frontend), Render (Backend), and Supabase.

# ------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CodePath"
NEXT_PUBLIC_APP_TAGLINE="Learn to Code. Build Projects. Become Career Ready."
NEXT_PUBLIC_API_URL="https://your-backend.onrender.com"
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxx"

# ------------------------------------------------------------
# BACKEND CONFIGURATION (Render / FastAPI)
# ------------------------------------------------------------
ENVIRONMENT="production"
DEBUG=False
PORT=8000
HOST="0.0.0.0"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="https://codepath.vercel.app,http://localhost:3000"

# Database Connection (Supabase Postgres)
DATABASE_URL="postgresql://postgres:your-db-password@db.xxxxxxxx.supabase.co:5432/postgres"

# Supabase Credentials (Render Environment - Never commit these)
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SECRET_KEY="xxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxxxxxx"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# AI Service Configuration
# Supported providers: gemini, openai, anthropic, mock
AI_PROVIDER="gemini"
AI_API_KEY="your-gemini-or-openai-api-key"
AI_MODEL_NAME="gemini-1.5-flash"
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.7

# Code Execution Security Sandbox
CODE_EXECUTION_TIMEOUT_SECONDS=8
CODE_EXECUTION_MAX_MEMORY_MB=128
CODE_EXECUTION_SANDBOX_ENABLED=True
CODE_EXECUTION_WORKER_CONCURRENCY=4

# Storage
SUPABASE_STORAGE_BUCKET_RESUMES="resumes"
SUPABASE_STORAGE_BUCKET_PROJECTS="projects"
SUPABASE_STORAGE_BUCKET_AVATARS="avatars"
